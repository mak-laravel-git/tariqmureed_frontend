# Laravel API base (no trailing slash). Must include /api/v1.
# Leave empty to use bundled mock data.
API_URL=http://localhost:8000/api/v1

# Optional Bearer token for public/server API calls (admin login uses its own session).
API_TOKEN=

# When true, failed API requests fall back to local mock data (dev convenience).
API_FALLBACK_TO_MOCKS=true

# Timezone used by the site (defaults to Asia/Dhaka if unset).
SITE_TIMEZONE=Asia/Dhaka

# Extra image hosts for next/image (comma-separated). API_URL host is allowed automatically.
IMAGE_HOSTS=
