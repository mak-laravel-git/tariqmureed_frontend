# Laravel API base (no trailing slash). Must include /api/v1.
# Leave empty to use bundled mock data.
API_URL=http://localhost:8000/api/v1

# Optional Bearer token for public/server API calls (admin login uses its own session).
API_TOKEN=

# When true, failed API requests fall back to local mock data (dev convenience).
API_FALLBACK_TO_MOCKS=true

# Timezone used by the site (defaults to Asia/Dhaka if unset).
SITE_TIMEZONE=Asia/Dhaka
# The live address for canonical links, sitemap.xml and share previews (https://tmnsport.com).
# The admin SEO screen overrides it; this is the fallback.
SITE_URL=https://tmnsport.com

# Extra image hosts for next/image (comma-separated). API_URL host is allowed automatically.
IMAGE_HOSTS=

# --- Privacy, consent and Google tags ---
# These are set in the admin dashboard (Website Settings). The values below are only a fallback for
# fields left empty there, and are read at runtime (no rebuild needed).
GA_MEASUREMENT_ID=
ADSENSE_CLIENT_ID=
# "builtin" (default) or "google" (Google-certified "Privacy & messaging" message from AdSense).
CONSENT_MODE=builtin
CONTACT_EMAIL=
CONTACT_ADDRESS=
